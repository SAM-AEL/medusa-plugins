{
  "name": "@sam-ael/medusa-plugin-discord",
  "version": "2.0.0",
  "description": "Send Discord webhook notifications on Medusa store events with dynamic settings.",
  "author": "SAM-AEL (https://www.github.com/SAM-AEL)",
  "homepage": "https://github.com/SAM-AEL/medusa-plugins/tree/main/packages/medusa-plugin-discord#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAM-AEL/medusa-plugins.git",
    "directory": "packages/medusa-plugin-discord"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    ".medusa/server",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusajs",
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-notification",
    "discord"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --no-warnings --loader ../../scripts/ts-loader.mjs --test src/tests/discord.test.ts",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.15.5",
    "@medusajs/admin-shared": "^2.15.5",
    "@medusajs/cli": "^2.15.5",
    "@medusajs/framework": "^2.15.5",
    "@medusajs/icons": "^2.15.5",
    "@medusajs/medusa": "^2.15.5",
    "@medusajs/test-utils": "^2.15.5",
    "@medusajs/ui": "^4.0.25",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.12.0",
    "@medusajs/medusa": "^2.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
