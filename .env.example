# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders.

# ---- Shared ----
STOREFRONT_URL=https://store.example.com
STORE_NAME=Example Store
STORE_URL=https://store.example.com
REDIS_URL=redis://localhost:6379

# ---- Discord (medusa-plugin-discord) ----
# Opt in to sending customer email/phone in Discord embeds. Default off.
DISCORD_INCLUDE_PII=false

# ---- Mailer (medusa-plugin-mailer) ----
MAILER_SMTP_HOST=smtp.example.com
MAILER_SMTP_PORT=587
MAILER_SMTP_USER=user@example.com
MAILER_SMTP_PASS=changeme
# Set to "true" only for SMTPS on port 465. Never enable DEBUG in production.
MAILER_SMTP_SECURE=false
MAILER_SMTP_DEBUG=false
MAILER_SMTP_NAME=Example Store
MAILER_SENDER_1_EMAIL=no-reply@example.com
MAILER_SENDER_1_NAME=Example Store
MAILER_FROM_ADDRESS_1=no-reply@example.com
MAILER_FROM_NAME_1=Example Store
MAILER_TEMPLATES_DIR=
MAILER_LOGO_URL=https://store.example.com/logo.png
MAILER_SEND_CONCURRENCY=2

# ---- PayU (medusa-plugin-payu) ----
PAYU_MERCHANT_KEY=your-merchant-key
PAYU_MERCHANT_SALT=your-merchant-salt
PAYU_ENVIRONMENT=test
PAYU_REDIRECT_URL=/order/confirmed
PAYU_REDIRECT_FAILURE_URL=/checkout
PAYU_API_TIMEOUT_MS=15000

# ---- Shiprocket (medusa-plugin-shiprocket) ----
SHIPROCKET_EMAIL=user@example.com
SHIPROCKET_PASSWORD=changeme
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=110001
SHIPROCKET_DELIVERY_PREFERENCE=FAST
SHIPROCKET_WEBHOOK_TOKEN=generate-a-random-string-of-at-least-32-chars
SHIPROCKET_WEBHOOK_PAYLOAD_RETENTION_DAYS=30
SHIPROCKET_API_TIMEOUT_MS=15000

# ---- WhatsApp (medusa-plugin-whatsapp) ----
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890
WHATSAPP_API_VERSION=v25.0
WHATSAPP_SEND_CONCURRENCY=2
WHATSAPP_API_TIMEOUT_MS=15000
WHATSAPP_LOG_RETENTION_DAYS=30
